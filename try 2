                },
                {
                    id: 11,
                    type: "report",
                    title: "FINAL INTELLIGENCE REPORT",
                    subtitle: "Official Bureau Assessment Submission",
                    sentences: [
                        { label: "Based on available evidence...", key: "s1", options: ["The Guard", "The Curator", "The Delivery Driver"], correct: "The Guard" },
                        { label: "The strongest supporting evidence was...", key: "s2", options: ["Storage Access", "GPS", "Witness", "Timeline", "CCTV"], correct: "Storage Access" },
                        { label: "Recommendation...", key: "s3", options: ["Further Investigation Required", "Immediate Arrest", "Close Case", "Collect Additional Evidence"], correct: "Further Investigation Required" }
                    ]
                },
                {
                    id: 12,
                    type: "success",
                    title: "CASE ACCOMPLISHED",
                    subtitle: "Final Intelligence Review & Debrief",
                    summary: "• The Guard was the only suspect confirmed inside the restricted storage room.<br>• CCTV supports the Guard's movement near the time of disappearance.<br>• GPS confirms the Guard remained inside the museum.<br>• The Curator was ruled out because restaurant GPS confirmed her location.<br>• The Delivery Driver was ruled out because he had already left before the incident.<br>• Although suspicion is high, investigators still require direct physical evidence before formal prosecution."
                }
            ]
        };

        // Initialize Engine
        function initEngine() {
            caseData = case001Definition;
            loadSavedState();
            renderCurrentBoard();
            updateToolboxUI();
        }

        // Save & Load State Storage
        function saveState() {
            try {
                localStorage.setItem('intel_bureau_state', JSON.stringify(gameState));
                localStorage.setItem('intel_bureau_board', currentBoardIndex);
            } catch (e) {
                console.error('Storage error:', e);
            }
        }

        function loadSavedState() {
            try {
                const savedState = localStorage.getItem('intel_bureau_state');
                if (savedState) {
                    gameState = JSON.parse(savedState);
                }
                const savedBoard = localStorage.getItem('intel_bureau_board');
                if (savedBoard !== null) {
                    currentBoardIndex = parseInt(savedBoard, 10);
                }
            } catch (e) {
                console.error('Error loading state:', e);
            }
        }

        // Navigation Controller
        function loadBoard(index) {
            if (index < 0 || index >= caseData.boards.length) return;
            
            const container = document.getElementById('board-render-container');
            container.classList.add('fade-out');

            setTimeout(() => {
                currentBoardIndex = index;
                renderCurrentBoard();
                container.classList.remove('fade-out');
                saveState();
            }, 250);
        }

        function nextBoard() {
            if (currentBoardIndex < caseData.boards.length - 1) {
                loadBoard(currentBoardIndex + 1);
            }
        }

        function previousBoard() {
            if (currentBoardIndex > 0) {
                loadBoard(currentBoardIndex - 1);
            }
        }

        // Render Dispatcher
        function renderCurrentBoard() {
            const board = caseData.boards[currentBoardIndex];
            const container = document.getElementById('board-render-container');
            const counter = document.getElementById('board-counter-display');
            const prevBtn = document.getElementById('prev-btn');
            const nextBtn = document.getElementById('next-btn');

            counter.innerText = `Board ${currentBoardIndex + 1} / ${caseData.boards.length}`;
            prevBtn.disabled = (currentBoardIndex === 0);
            
            if (currentBoardIndex === caseData.boards.length - 1) {
                nextBtn.innerText = "Return to Office";
                nextBtn.onclick = returnToOffice;
                nextBtn.disabled = false;
            } else {
                nextBtn.innerText = "Next";
                nextBtn.onclick = nextBoard;
                // Check if current board requires validation
                if (board.type === 'question' || board.type === 'hypothesis' || board.type === 'report') {
                    nextBtn.disabled = !gameState.boardValidationStatus[board.id];
                } else {
                    nextBtn.disabled = false;
                }
            }

            container.innerHTML = '';

            // Header elements
            const heading = document.createElement('h2');
            heading.className = 'board-heading';
            heading.innerText = board.title;
            container.appendChild(heading);

            if (board.subtitle) {
                const subheading = document.createElement('p');
                subheading.className = 'board-subheading';
                subheading.innerText = board.subtitle;
                container.appendChild(subheading);
            }

            // Type Specific Renderers
            switch (board.type) {
                case 'information':
                    renderInformation(board, container);
                    break;
                case 'timeline':
                    renderTimeline(board, container);
                    break;
                case 'question':
                    renderQuestion(board, container);
                    break;
                case 'suspects':
                    renderSuspects(board, container);
                    break;
                case 'evidence_viewer':
                    renderEvidence(board, container);
                    break;
                case 'hypothesis':
                    renderHypothesis(board, container);
                    break;
                case 'report':
                    renderReport(board, container);
                    break;
                case 'success':
                    renderSuccess(board, container);
                    break;
                default:
                    renderInformation(board, container);
            }
        }

        // Component Renderers
        function renderInformation(board, container) {
            const body = document.createElement('div');
            body.className = 'board-body-text';
            body.innerHTML = board.content;
            container.appendChild(body);
        }

        function renderTimeline(board, container) {
            const list = document.createElement('div');
            list.className = 'timeline-list';
            board.events.forEach(ev => {
                const item = document.createElement('div');
                item.className = 'timeline-item';
                item.innerHTML = `<strong>${ev.time}</strong> <span>${ev.description}</span>`;
                list.appendChild(item);
            });
            container.appendChild(list);
        }

        function renderQuestion(board, container) {
            const body = document.createElement('div');
            body.className = 'board-body-text';
            body.innerHTML = board.content;
            container.appendChild(body);

            const qText = document.createElement('p');
            qText.style.fontWeight = '600';
            qText.style.margin = '16px 0 8px 0';
            qText.innerText = board.questionText;
            container.appendChild(qText);

            const select = document.createElement('select');
            select.className = 'bureau-select';
            select.innerHTML = '<option value="">-- Select Assessment --</option>' + 
                board.options.map(opt => `<option value="${opt}">${opt}</option>`).join('');
            
            if (gameState.boardValidationStatus[board.id]) {
                select.value = board.correctAnswer;
                select.disabled = true;
            }

            select.onchange = (e) => validateQuestionAnswer(board, e.target.value);
            container.appendChild(select);

            const feedback = document.createElement('div');
            feedback.id = `feedback-${board.id}`;
            feedback.className = 'validation-feedback';
            if (gameState.boardValidationStatus[board.id]) {
                feedback.className = 'validation-feedback success';
                feedback.innerText = 'Analysis Accepted.';
                feedback.style.display = 'block';
            }
            container.appendChild(feedback);
        }

        function validateQuestionAnswer(board, answer) {
            const feedback = document.getElementById(`feedback-${board.id}`);
            const nextBtn = document.getElementById('next-btn');

            if (answer === board.correctAnswer) {
                feedback.className = 'validation-feedback success';
                feedback.innerText = 'Analysis Accepted.';
                feedback.style.display = 'block';
                gameState.boardValidationStatus[board.id] = true;
                nextBtn.disabled = false;
                saveState();
            } else if (answer !== "") {
                feedback.className = 'validation-feedback error';
                feedback.innerText = 'Incorrect Analysis. Review the available evidence.';
                feedback.style.display = 'block';
                gameState.boardValidationStatus[board.id] = false;
                nextBtn.disabled = true;
                saveState();
            } else {
                feedback.style.display = 'none';
            }
        }

        function renderSuspects(board, container) {
            const list = document.createElement('div');
            list.className = 'suspect-list';
            board.suspects.forEach(s => {
                const card = document.createElement('div');
                card.className = 'suspect-card glass-panel';
                card.style.padding = '14px';
                card.innerHTML = `<strong style="color:var(--accent-blue);">${s.name} (${s.role})</strong><span style="font-size:0.8rem; color:var(--text-muted); margin-top:4px;">${s.info}</span>`;
                list.appendChild(card);
            });
            container.appendChild(list);
        }

        function renderEvidence(board, container) {
            const grid = document.createElement('div');
            grid.className = 'evidence-grid';

            board.evidenceList.forEach(item => {
                const isRead = gameState.readEvidenceIds.includes(item.id);
                const isBookmarked = gameState.bookmarkedEvidenceIds.includes(item.id);

                const card = document.createElement('div');
                card.className = `evidence-card ${isBookmarked ? 'bookmarked' : ''} ${!isRead ? 'unread' : ''}`;
                card.onclick = () => openEvidenceViewer(item);

                card.innerHTML = `
                    <span class="evidence-card-category">${item.category}</span>
                    <span class="evidence-card-title">${item.title}</span>
                `;
                grid.appendChild(card);
            });
            container.appendChild(grid);
            updateToolboxUI();
        }

        // Evidence Viewer Modal Functions
        let activeEvidenceItem = null;
        function openEvidenceViewer(item) {
            activeEvidenceItem = item;
            if (!gameState.readEvidenceIds.includes(item.id)) {
                gameState.readEvidenceIds.push(item.id);
                saveState();
                updateToolboxUI();
                // Refresh grid indicator if on board 9
                if (currentBoardIndex === 8) renderCurrentBoard();
            }

            document.getElementById('viewer-modal-category').innerText = item.category;
            document.getElementById('viewer-modal-title').innerText = item.title;
            document.getElementById('viewer-modal-content').innerHTML = `<p>${item.description}</p>`;
            
            const bmBtn = document.getElementById('viewer-bookmark-btn');
            bmBtn.innerText = gameState.bookmarkedEvidenceIds.includes(item.id) ? 'Remove Bookmark' : 'Bookmark Evidence';

            document.getElementById('evidence-viewer-overlay').classList.add('active');
        }

        function closeEvidenceViewer(e) {
            if (!e || e.target.id === 'evidence-viewer-overlay' || e.target.tagName === 'BUTTON') {
                document.getElementById('evidence-viewer-overlay').classList.remove('active');
                activeEvidenceItem = null;
            }
        }

        function toggleBookmarkCurrentEvidence() {
            if (!activeEvidenceItem) return;
            const idx = gameState.bookmarkedEvidenceIds.indexOf(activeEvidenceItem.id);
            if (idx > -1) {
                gameState.bookmarkedEvidenceIds.splice(idx, 1);
            } else {
                gameState.bookmarkedEvidenceIds.push(activeEvidenceItem.id);
            }
            saveState();
            updateToolboxUI();
            openEvidenceViewer(activeEvidenceItem);
            if (currentBoardIndex === 8) renderCurrentBoard();
        }

        function renderHypothesis(board, container) {
            const form = document.createElement('div');
            form.style.display = 'flex';
            form.style.flexDirection = 'column';
            form.style.gap = '12px';

            board.questions.forEach(q => {
                const label = document.createElement('label');
                label.style.fontSize = '0.85rem';
                label.style.fontWeight = '600';
                label.innerText = q.label;

                const select = document.createElement('select');
                select.className = 'bureau-select';
                select.id = `hyp-${q.key}`;
                select.innerHTML = '<option value="">-- Select --</option>' + q.options.map(opt => `<option value="${opt}">${opt}</option>`).join('');
                select.onchange = validateHypothesis;

                if (gameState.hypothesisAnswers && gameState.hypothesisAnswers[q.key]) {
                    select.value = gameState.hypothesisAnswers[q.key];
                }

                form.appendChild(label);
                form.appendChild(select);
            });

            container.appendChild(form);

            const feedback = document.createElement('div');
            feedback.id = 'hypothesis-feedback';
            feedback.className = 'validation-feedback';
            if (gameState.boardValidationStatus[board.id]) {
                feedback.className = 'validation-feedback success';
                feedback.innerText = 'Analysis Accepted.';
                feedback.style.display = 'block';
            }
            container.appendChild(feedback);
        }

        function validateHypothesis() {
            const board = caseData.boards[currentBoardIndex];
            const answers = {};
            let allAnswered = true;

            board.questions.forEach(q => {
                const val = document.getElementById(`hyp-${q.key}`).value;
                answers[q.key] = val;
                if (!val) allAnswered = false;
            });

            gameState.hypothesisAnswers = answers;
            const feedback = document.getElementById('hypothesis-feedback');
            const nextBtn = document.getElementById('next-btn');

            if (!allAnswered) {
                feedback.style.display = 'none';
                return;
            }

            let correct = true;
            board.questions.forEach(q => {
                if (answers[q.key] !== q.correct) correct = false;
            });

            if (correct) {
                feedback.className = 'validation-feedback success';
                feedback.innerText = 'Analysis Accepted.';
                feedback.style.display = 'block';
                gameState.boardValidationStatus[board.id] = true;
                nextBtn.disabled = false;
            } else {
                feedback.className = 'validation-feedback error';
                feedback.innerText = 'The evidence does not fully support this conclusion.';
                feedback.style.display = 'block';
                gameState.boardValidationStatus[board.id] = false;
                nextBtn.disabled = true;
            }
            saveState();
        }

        function renderReport(board, container) {
            const form = document.createElement('div');
            form.style.display = 'flex';
            form.style.flexDirection = 'column';
            form.style.gap = '12px';

            board.sentences.forEach(s => {
                const label = document.createElement('label');
                label.style.fontSize = '0.85rem';
                label.style.fontWeight = '600';
                label.innerText = s.label;

                const select = document.createElement('select');
                select.className = 'bureau-select';
                select.id = `rep-${s.key}`;
                select.innerHTML = '<option value="">-- Select Assessment --</option>' + s.options.map(opt => `<option value="${opt}">${opt}</option>`).join('');
                select.onchange = validateReport;

                if (gameState.reportAnswers && gameState.reportAnswers[s.key]) {
                    select.value = gameState.reportAnswers[s.key];
                }

                form.appendChild(label);
                form.appendChild(select);
            });

            container.appendChild(form);

            const feedback = document.createElement('div');
            feedback.id = 'report-feedback';
            feedback.className = 'validation-feedback';
            if (gameState.boardValidationStatus[board.id]) {
                feedback.className = 'validation-feedback success';
                feedback.innerText = 'REPORT ACCEPTED';
                feedback.style.display = 'block';
            }
            container.appendChild(feedback);
        }

        function validateReport() {
            const board = caseData.boards[currentBoardIndex];
            const answers = {};
            let allAnswered = true;

            board.sentences.forEach(s => {
                const val = document.getElementById(`rep-${s.key}`).value;
                answers[s.key] = val;
                if (!val) allAnswered = false;
            });

            gameState.reportAnswers = answers;
            const feedback = document.getElementById('report-feedback');
            const nextBtn = document.getElementById('next-btn');

            if (!allAnswered) {
                feedback.style.display = 'none';
                return;
            }

            let correct = true;
            board.sentences.forEach(s => {
                if (answers[s.key] !== s.correct) correct = false;
            });

            if (correct) {
                feedback.className = 'validation-feedback success';
                feedback.innerText = 'REPORT ACCEPTED';
                feedback.style.display = 'block';
                gameState.boardValidationStatus[board.id] = true;
                nextBtn.disabled = false;
            } else {
                feedback.className = 'validation-feedback error';
                feedback.innerText = 'The evidence does not sufficiently support your report.';
                feedback.style.display = 'block';
                gameState.boardValidationStatus[board.id] = false;
                nextBtn.disabled = true;
            }
            saveState();
        }

        function renderSuccess(board, container) {
            const body = document.createElement('div');
            body.className = 'board-body-text';
            body.innerHTML = `<strong>EXCELLENT ANALYTICAL REASONING</strong><br>You successfully identified the most logical suspect using available intelligence.<br><br><strong>CASE SUMMARY:</strong><br>${board.summary}`;
            container.appendChild(body);
        }

        function returnToOffice() {
            localStorage.removeItem('intel_bureau_board');
            localStorage.removeItem('intel_bureau_state');
            alert('Case archived successfully. Returning to Bureau Office dashboard.');
            currentBoardIndex = 0;
            gameState = { readEvidenceIds: [], bookmarkedEvidenceIds: [], notes: '', boardValidationStatus: {} };
            initEngine();
        }

        // Toolbox Controller
        const toggleBtn = document.getElementById('toggle-toolbox-btn');
        const toolboxPanel = document.getElementById('toolbox-panel');
        const notesInput = document.getElementById('analyst-notes-input');

        toggleBtn.onclick = () => {
            toolboxPanel.classList.toggle('active');
        };

        function toggleToolbox() {
            toolboxPanel.classList.remove('active');
        }

        notesInput.oninput = (e) => {
            gameState.notes = e.target.value;
            saveState();
        };

        function updateToolboxUI() {
            document.getElementById('stat-read-count').innerText = gameState.readEvidenceIds.length;
            document.getElementById('stat-total-evidence').innerText = case001Definition.boards[8].evidenceList.length;
            document.getElementById('stat-bookmark-count').innerText = gameState.bookmarkedEvidenceIds.length;
            if (notesInput.value !== gameState.notes) {
                notesInput.value = gameState.notes || '';
            }
        }

        // Boot Engine on Load
        window.addEventListener('DOMContentLoaded', initEngine);
    </script>
</body>
</html>
