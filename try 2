<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Intel Bureau - Classified Intelligence Engine</title>
    <style>
        :root {
            --bg-primary: #050b14;
            --bg-secondary: #0a1424;
            --panel-bg: rgba(10, 20, 36, 0.75);
            --panel-border: rgba(41, 79, 128, 0.3);
            --panel-border-glow: rgba(56, 189, 248, 0.4);
            --text-main: #f0f6fc;
            --text-muted: #8b949e;
            --accent-blue: #38bdf8;
            --accent-blue-hover: #0ea5e9;
            --accent-dim: rgba(56, 189, 248, 0.1);
            --success-color: #10b981;
            --error-color: #ef4444;
            --warning-color: #f59e0b;
            --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            --transition-speed: 250ms;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg-primary);
            font-family: var(--font-family);
            color: var(--text-main);
        }

        #landscape-wrapper {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100vw;
            height: 100vh;
            background-color: var(--bg-primary);
            background-image: radial-gradient(circle at 50% 30%, #0c1c38 0%, #050b14 80%);
            background-size: 100% 100%;
            background-position: center;
            background-repeat: no-repeat;
            transform-origin: center center;
            transition: transform 0.3s ease;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Glassmorphism Panels */
        .glass-panel {
            background: var(--panel-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--panel-border);
            border-radius: 8px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        /* Top Header */
        header.bureau-header {
            height: 60px;
            padding: 0 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--panel-border);
            background: rgba(5, 11, 20, 0.85);
            z-index: 10;
            flex-shrink: 0;
        }

        .header-title-group h1 {
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: var(--accent-blue);
            text-transform: uppercase;
        }

        .header-title-group span {
            font-size: 0.75rem;
            color: var(--text-muted);
            letter-spacing: 0.5px;
        }

        .header-meta {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .board-counter {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-main);
            background: var(--accent-dim);
            padding: 4px 10px;
            border-radius: 4px;
            border: 1px solid rgba(56, 189, 248, 0.2);
        }

        .toolbox-toggle-btn {
            background: transparent;
            border: 1px solid var(--panel-border);
            color: var(--text-main);
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all var(--transition-speed);
        }

        .toolbox-toggle-btn:hover {
            border-color: var(--accent-blue);
            color: var(--accent-blue);
        }

        /* Main Game Viewport */
        .game-viewport {
            flex: 1;
            position: relative;
            padding: 16px 24px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .board-container {
            width: 100%;
            height: 100%;
            max-width: 1100px;
            max-height: calc(100vh - 140px);
            display: flex;
            flex-direction: column;
            padding: 24px;
            position: relative;
            overflow-y: auto;
            opacity: 1;
            transition: opacity var(--transition-speed), transform var(--transition-speed);
        }

        .board-container.fade-out {
            opacity: 0;
            transform: translateY(-10px);
        }

        .board-container::-webkit-scrollbar {
            width: 4px;
        }
        .board-container::-webkit-scrollbar-thumb {
            background: var(--panel-border);
            border-radius: 2px;
        }

        /* Typography & Content Layout inside Boards */
        .board-heading {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-main);
            letter-spacing: 0.5px;
        }

        .board-subheading {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-bottom: 20px;
            line-height: 1.4;
        }

        .board-body-text {
            font-size: 0.9rem;
            line-height: 1.6;
            color: var(--text-main);
            margin-bottom: 16px;
        }

        /* Bottom Navigation Bar */
        footer.bureau-footer {
            height: 64px;
            padding: 0 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--panel-border);
            background: rgba(5, 11, 20, 0.85);
            z-index: 10;
            flex-shrink: 0;
        }

        .bureau-btn {
            background: var(--bg-secondary);
            border: 1px solid var(--panel-border);
            color: var(--text-main);
            padding: 10px 24px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: all var(--transition-speed);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .bureau-btn:hover:not(:disabled) {
            background: var(--accent-dim);
            border-color: var(--accent-blue);
            color: var(--accent-blue);
            transform: translateY(-1px);
        }

        .bureau-btn:active:not(:disabled) {
            transform: translateY(1px);
        }

        .bureau-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            border-color: var(--panel-border);
        }

        .bureau-btn.primary {
            background: var(--accent-blue);
            color: #050b14;
            border-color: var(--accent-blue);
        }

        .bureau-btn.primary:hover:not(:disabled) {
            background: var(--accent-blue-hover);
            color: #050b14;
        }

        /* Validation Feedback Message Box */
        .validation-feedback {
            margin-top: 16px;
            padding: 12px 16px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 500;
            display: none;
            animation: fadeIn 0.2s ease forwards;
        }

        .validation-feedback.error {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
        }

        .validation-feedback.success {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #6ee7b7;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Evidence Cards Grid */
        .evidence-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 12px;
            margin-top: 12px;
            overflow-y: auto;
            max-height: 60vh;
            padding-right: 4px;
        }

        .evidence-card {
            background: rgba(15, 25, 45, 0.6);
            border: 1px solid var(--panel-border);
            border-radius: 6px;
            padding: 14px;
            cursor: pointer;
            transition: all var(--transition-speed);
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .evidence-card:hover {
            border-color: var(--accent-blue);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(56, 189, 248, 0.1);
        }

        .evidence-card.bookmarked {
            border-color: var(--accent-blue);
            box-shadow: 0 0 8px rgba(56, 189, 248, 0.2);
        }

        .evidence-card.unread::after {
            content: '';
            position: absolute;
            top: 12px;
            right: 12px;
            width: 8px;
            height: 8px;
            background: var(--accent-blue);
            border-radius: 50%;
        }

        .evidence-card-category {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--accent-blue);
            font-weight: 700;
        }

        .evidence-card-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-main);
        }

        /* Evidence Viewer Modal Overlay */
        .evidence-viewer-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(5, 11, 20, 0.85);
            backdrop-filter: blur(8px);
            z-index: 100;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity var(--transition-speed);
        }

        .evidence-viewer-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .evidence-viewer-modal {
            width: 90%;
            max-width: 700px;
            max-height: 85vh;
            background: var(--bg-secondary);
            border: 1px solid var(--panel-border-glow);
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            transform: scale(0.95);
            transition: transform var(--transition-speed);
        }

        .evidence-viewer-overlay.active .evidence-viewer-modal {
            transform: scale(1);
        }

        .viewer-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--panel-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(10, 20, 36, 0.95);
        }

        .viewer-body {
            padding: 20px;
            overflow-y: auto;
            flex: 1;
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .viewer-footer {
            padding: 12px 20px;
            border-top: 1px solid var(--panel-border);
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            background: rgba(10, 20, 36, 0.95);
        }

        /* Toolbox Side Panel */
        .toolbox-panel {
            position: absolute;
            top: 60px;
            right: 0;
            width: 320px;
            height: calc(100vh - 124px);
            background: rgba(8, 16, 28, 0.95);
            backdrop-filter: blur(16px);
            border-left: 1px solid var(--panel-border);
            z-index: 50;
            transform: translateX(100%);
            transition: transform 0.3s ease;
            display: flex;
            flex-direction: column;
            padding: 20px;
            gap: 20px;
        }

        .toolbox-panel.active {
            transform: translateX(0);
        }

        .toolbox-section h3 {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--accent-blue);
            margin-bottom: 8px;
        }

        .toolbox-notes-area {
            width: 100%;
            height: 150px;
            background: rgba(5, 11, 20, 0.6);
            border: 1px solid var(--panel-border);
            border-radius: 4px;
            color: var(--text-main);
            padding: 10px;
            font-family: var(--font-family);
            font-size: 0.85rem;
            resize: none;
            outline: none;
        }

        .toolbox-notes-area:focus {
            border-color: var(--accent-blue);
        }

        /* Timeline & List Styles */
        .timeline-list, .suspect-list, .match-container {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 12px;
        }

        .timeline-item, .suspect-card {
            background: rgba(15, 25, 45, 0.6);
            border: 1px solid var(--panel-border);
            padding: 12px 16px;
            border-radius: 6px;
            font-size: 0.85rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .suspect-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
        }

        /* Form Controls */
        .bureau-select, .bureau-input {
            width: 100%;
            background: rgba(15, 25, 45, 0.8);
            border: 1px solid var(--panel-border);
            color: var(--text-main);
            padding: 10px 14px;
            border-radius: 6px;
            font-size: 0.9rem;
            outline: none;
            margin-top: 8px;
            margin-bottom: 16px;
            transition: border-color var(--transition-speed);
        }

        .bureau-select:focus, .bureau-input:focus {
            border-color: var(--accent-blue);
        }

        /* Tables */
        .bureau-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
            font-size: 0.85rem;
        }

        .bureau-table th, .bureau-table td {
            padding: 10px 12px;
            text-align: left;
            border-bottom: 1px solid var(--panel-border);
        }

        .bureau-table th {
            color: var(--accent-blue);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }

        /* Responsive Layout Adjustments */
        @media (max-width: 768px) {
            header.bureau-header, footer.bureau-footer {
                padding: 0 16px;
                height: 52px;
            }
            .game-viewport {
                padding: 12px 16px;
            }
            .board-container {
                padding: 16px;
                max-height: calc(100vh - 104px);
            }
            .board-heading {
                font-size: 1.25rem;
            }
            .evidence-grid {
                grid-template-columns: 1fr;
            }
            .toolbox-panel {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <div id="landscape-wrapper">
        <header class="bureau-header">
            <div class="header-title-group">
                <h1 id="mission-title-header">INTEL BUREAU</h1>
                <span id="case-subtitle-header">CASE 001: THE MISSING MUSEUM ARTIFACT</span>
            </div>
            <div class="header-meta">
                <div class="board-counter" id="board-counter-display">Board 1 / 12</div>
                <button class="toolbox-toggle-btn" id="toggle-toolbox-btn">Toolbox</button>
            </div>
        </header>

        <main class="game-viewport">
            <div class="glass-panel board-container" id="board-render-container">
                <!-- Dynamic Board Content injects here -->
            </div>
        </main>

        <footer class="bureau-footer">
            <button class="bureau-btn" id="prev-btn" onclick="previousBoard()">Previous</button>
            <button class="bureau-btn primary" id="next-btn" onclick="nextBoard()">Next</button>
        </footer>

        <!-- Toolbox Sidebar Panel -->
        <div class="toolbox-panel" id="toolbox-panel">
            <div class="toolbox-section">
                <h3>Analyst Statistics</h3>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Evidence Read: <span id="stat-read-count">0</span> / <span id="stat-total-evidence">6</span></p>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">Bookmarks Active: <span id="stat-bookmark-count">0</span></p>
            </div>
            <div class="toolbox-section" style="flex: 1; display: flex; flex-direction: column;">
                <h3>Investigation Notes</h3>
                <textarea class="toolbox-notes-area" id="analyst-notes-input" placeholder="Record confidential deductions here..."></textarea>
            </div>
            <button class="bureau-btn" onclick="toggleToolbox()" style="width: 100%; justify-content: center;">Close Toolbox</button>
        </div>

        <!-- Evidence Viewer Modal -->
        <div class="evidence-viewer-overlay" id="evidence-viewer-overlay" onclick="closeEvidenceViewer(event)">
            <div class="evidence-viewer-modal" onclick="event.stopPropagation()">
                <div class="viewer-header">
                    <div>
                        <span class="evidence-card-category" id="viewer-modal-category">CATEGORY</span>
                        <h2 style="font-size: 1.1rem; font-weight: 600; margin-top: 2px;" id="viewer-modal-title">Evidence Title</h2>
                    </div>
                    <button class="bureau-btn" style="padding: 6px 12px; font-size: 0.75rem;" onclick="closeEvidenceViewer()">Close</button>
                </div>
                <div class="viewer-body" id="viewer-modal-content">
                    <!-- Dynamic Evidence Content -->
                </div>
                <div class="viewer-footer">
                    <button class="bureau-btn" id="viewer-bookmark-btn" onclick="toggleBookmarkCurrentEvidence()">Bookmark Evidence</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Force Landscape / Window Scale Alignment for Mobile
        function forceLandscape() {
            const wrapper = document.getElementById('landscape-wrapper');
            const windowWidth = window.innerWidth;
            const windowHeight = window.innerHeight;

            if (windowWidth < windowHeight) {
                wrapper.style.width = windowHeight + 'px';
                wrapper.style.height = windowWidth + 'px';
                wrapper.style.transform = `translate(-50%, -50%) rotate(90deg)`;
                wrapper.style.position = 'absolute';
                wrapper.style.top = '50%';
                wrapper.style.left = '50%';
            } else {
                wrapper.style.width = '100vw';
                wrapper.style.height = '100vh';
                wrapper.style.transform = `translate(-50%, -50%) rotate(0deg)`;
                wrapper.style.position = 'absolute';
                wrapper.style.top = '0';
                wrapper.style.left = '0';
            }
        }

        window.addEventListener('load', forceLandscape);
        window.addEventListener('resize', forceLandscape);

        // Core Application State & Storage
        let currentBoardIndex = 0;
        let caseData = null;
        let gameState = {
            readEvidenceIds: [],
            bookmarkedEvidenceIds: [],
            notes: '',
            boardValidationStatus: {}
        };

        // Complete Case 001 Definition (12 Professional Intelligence Boards)
